# PostgreSQL Database Connection URL
# e.g., Supabase, Neon, Railway, or local: postgresql://USER:PASSWORD@localhost:5432/billflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/billflow?schema=public"

# Secret used to sign login session tokens
AUTH_SECRET="change-me-to-a-long-random-string"

# Google Gemini API key used server-side for AI Bill Maker features
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Google Sign-In (OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Delivery for 6-Digit Verification Codes (https://resend.com)
# Leave empty to test in demo mode (code is printed to server terminal & preview badge)
RESEND_API_KEY=""
EMAIL_FROM="BillFlow <onboarding@resend.dev>"

# Webhook Secret for Subscription payment fulfillment (e.g. Stripe, Razorpay)
SUBSCRIPTION_WEBHOOK_SECRET="change-me-to-a-webhook-secret"

